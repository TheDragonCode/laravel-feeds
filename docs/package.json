{
    "name": "laravel-feeds-docs",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "docusaurus": "docusaurus",
        "start": "docusaurus start",
        "build": "npm run check:metadata && npm run check:i18n && npm run check:snippets && npm run typecheck && npm run build:llms && docusaurus build",
        "serve": "docusaurus serve",
        "clear": "docusaurus clear",
        "typecheck": "tsc --noEmit",
        "write-translations": "docusaurus write-translations",
        "docs:version": "node scripts/version-docs.mjs",
        "translate": "npm run translate:be && npm run translate:de && npm run translate:fr && npm run translate:ko && npm run translate:pt-BR && npm run translate:ru && npm run translate:uk && npm run translate:zh-CN",
        "translate:be": "docusaurus write-translations --locale be",
        "translate:de": "docusaurus write-translations --locale de",
        "translate:fr": "docusaurus write-translations --locale fr",
        "translate:ko": "docusaurus write-translations --locale ko",
        "translate:pt-BR": "docusaurus write-translations --locale pt-BR",
        "translate:ru": "docusaurus write-translations --locale ru",
        "translate:uk": "docusaurus write-translations --locale uk",
        "translate:zh-CN": "docusaurus write-translations --locale zh-CN",
        "check:i18n": "node scripts/check-i18n.mjs",
        "content:manifest": "node scripts/content-manifest.mjs",
        "check:content": "node scripts/content-manifest.mjs --check",
        "check:metadata": "node scripts/content-manifest.mjs --check",
        "check:seo": "node scripts/check-built-site.mjs",
        "check:snippets": "node scripts/check-snippets.mjs",
        "build:llms": "node scripts/build-llms.mjs",
        "test:e2e": "playwright test tests/e2e.spec.ts tests/versioned-llms.spec.ts",
        "test:a11y": "playwright test tests/accessibility.spec.ts",
        "test:visual": "playwright test tests/visual.spec.ts",
        "test:visual:update": "playwright test tests/visual.spec.ts --update-snapshots",
        "test:browser": "playwright test",
        "test:performance": "lhci autorun"
    },
    "dependencies": {
        "@docusaurus/core": "3.10.2",
        "@docusaurus/faster": "3.10.2",
        "@docusaurus/plugin-client-redirects": "3.10.2",
        "@docusaurus/preset-classic": "3.10.2",
        "@mdx-js/react": "^3.1.1",
        "clsx": "^2.1.1",
        "prism-react-renderer": "^2.4.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@docusaurus/module-type-aliases": "3.10.2",
        "@docusaurus/types": "3.10.2",
        "@lhci/cli": "^0.15.1",
        "@playwright/test": "^1.64.1",
        "@types/react": "^19.3.0",
        "typescript": "~7.0.2"
    },
    "overrides": {
        "@lhci/utils": {
            "js-yaml": "3.15.2"
        },
        "@puppeteer/browsers": "3.2.5",
        "basic-ftp": "6.2.3",
        "image-size": "2.0.4",
        "js-yaml": "5.5.0",
        "nanoid": "6.0.2",
        "postcss-selector-parser": "7.1.7",
        "serialize-javascript": "7.1.2",
        "tinypool": "2.2.0",
        "tmp": "0.2.7",
        "uuid": "14.0.3"
    },
    "browserslist": {
        "production": [
            ">0.5%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 3 chrome version",
            "last 3 firefox version",
            "last 5 safari version"
        ]
    },
    "engines": {
        "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
    },
    "allowScripts": {
        "@swc/core@1.16.18": true,
        "core-js": false
    }
}
